# Copy to server/.env. The AI agent runs only on the local dev server (`pnpm dev`, bound to 127.0.0.1);
# a deployed site never reads these keys. Every question is billed to the AI account whose key you set here.

# Set ONE model key: Anthropic runs the agent on Claude, OpenAI on GPT. If both are set, Anthropic wins.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Vercel AI Gateway key for JEV question triage. Without it, triage falls back to a free local keyword check.
AI_GATEWAY_API_KEY=
