{
  "name": "project-cosmos",
  "private": true,
  "author": "Or Assayag",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "concurrently -n client,server \"pnpm --filter @project-cosmos/client dev\" \"pnpm dev:server\"",
    "dev:client": "pnpm --filter @project-cosmos/client dev",
    "dev:server": "tsx watch server/scripts/dev-server.ts",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:scripts",
    "lint": "eslint .",
    "validate": "tsx drift-sync/scripts/validate.ts",
    "types:emit": "tsx server/scripts/emit-client-types.ts",
    "sync": "tsx drift-sync/scripts/sync.ts",
    "sync:bootstrap": "tsx drift-sync/scripts/bootstrap-state.ts",
    "sync:diff-repo": "tsx drift-sync/scripts/diff-repo.ts",
    "sync:nightly": "tsx drift-sync/scripts/sync-nightly.ts",
    "sync:apply": "tsx drift-sync/scripts/apply-edits.ts",
    "sync:clone-repos": "tsx drift-sync/scripts/clone-repos.ts",
    "fresh": "node scripts/fresh-start.mjs",
    "record:demo": "node scripts/record-demo.mjs",
    "fixture:cosmos": "tsx scripts/dump-cosmos-response.ts",
    "parity:screens": "node scripts/parity-screens.mjs",
    "cosmos:check": "tsx scripts/cosmos-check.ts",
    "test:scripts": "tsx --test scripts/__tests__/*.test.ts drift-sync/scripts/__tests__/*.test.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.4",
    "@playwright/test": "~1.64.0",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "vite": "^8.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "A living map of your architecture — services as stars, flows as playable comets, honesty as a nightly AI agent.",
  "license": "MIT",
  "homepage": "https://project-cosmos-six.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orassayag/project-cosmos.git"
  }
}
